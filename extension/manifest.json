{
  "manifest_version": 3,
  "name": "Record in Takes",
  "short_name": "Takes",
  "version": "1.0.0",
  "description": "Select words on any page and record them as a video script in Takes, the free Mac teleprompter.",
  "homepage_url": "https://gettakes.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Record in Takes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ]
}
